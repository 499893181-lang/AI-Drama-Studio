{
  "name": "ai-drama-studio",
  "version": "0.11.0",
  "private": true,
  "description": "Windows 本地多渠道 AI 短剧创作、声音与剪辑工作台",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "node scripts/check-ui.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview:creative": "node scripts/preview-creative.mjs",
    "test:creative-browser": "node tests/creative-browser-smoke.mjs",
    "test:image-browser": "node tests/image-browser-smoke.mjs",
    "test:auto-image-browser": "node tests/auto-image-browser-smoke.mjs",
    "test:image-diagnostics-browser": "node tests/image-diagnostics-browser.mjs",
    "test:video-browser": "node tests/video-browser-smoke.mjs",
    "test:timeline-browser": "node tests/timeline-browser-smoke.mjs",
    "test:canvas-video-browser": "node tests/canvas-video-browser-smoke.mjs",
    "test:c-ui": "node tests/studio-shell-browser-smoke.mjs && node tests/story-c-ui-browser.mjs && node tests/creative-c-ui-browser.mjs && node tests/ui-c-media-browser.mjs",
    "test:studio-browser": "node tests/studio-v12-browser.mjs",
    "verify:production": "node scripts/verify-production-v12.mjs"
  },
  "license": "MIT"
}
